# HELP hlmg_requests_total Total gateway requests by HTTP status.
# TYPE hlmg_requests_total counter
hlmg_requests_total{status="200"} 1
hlmg_requests_total{status="500"} 1
# HELP hlmg_active_requests Currently in-flight requests.
# TYPE hlmg_active_requests gauge
hlmg_active_requests 0
# HELP hlmg_agents Registered agent entries, including ones whose heartbeats have expired.
# TYPE hlmg_agents gauge
hlmg_agents 2
# HELP hlmg_agents_healthy Registered agents whose last heartbeat is within agent_stale_secs (routable candidates).
# TYPE hlmg_agents_healthy gauge
hlmg_agents_healthy 1
# HELP hlmg_tunnel_retries_total Tunnel-setup failures that led to an agent switch, by outcome. ok and failed count retries; no-alternative counts the times there was no other agent to switch to, so it is not a retry and the family sum is neither the retry count nor the failure count.
# TYPE hlmg_tunnel_retries_total counter
hlmg_tunnel_retries_total{outcome="ok"} 1
# HELP hlmg_agent_rejections_total Requests rejected because no routable agent was available, by reason.
# TYPE hlmg_agent_rejections_total counter
hlmg_agent_rejections_total{reason="all-candidates-stale"} 1
hlmg_agent_rejections_total{reason="registry-empty"} 1
# HELP hlmg_forward_ends_total Response forwarding exits by reason. Most of these happen after a 200 was already written to the client (truncated body, idle timeout, upstream closed), so the access log cannot show them; see ForwardEnd::label for the kinds.
# TYPE hlmg_forward_ends_total counter
hlmg_forward_ends_total{kind="upstream_end"} 1
# HELP hlmg_client_stalls_total Requests abandoned because the client stopped making progress, by direction. Kept slots do not leak: each one is released when the request ends.
# TYPE hlmg_client_stalls_total counter
hlmg_client_stalls_total{phase="request-body"} 1
# HELP hlmg_upstream_head_timeouts_total Response heads that exceeded head_timeout_secs; class=slow means the agent had answered recently and is merely blocked (504, not evicted), class=silent means nothing came back within the window (counts toward eviction).
# TYPE hlmg_upstream_head_timeouts_total counter
hlmg_upstream_head_timeouts_total{class="slow"} 1
# HELP hlmg_tunnel_open_timeouts_total Tunnel stream opens that exceeded tunnel_op_secs; class=busy means the agent was at capacity (backpressure, not evicted), class=dead means the connection was treated as broken and evicted.
# TYPE hlmg_tunnel_open_timeouts_total counter
hlmg_tunnel_open_timeouts_total{class="busy"} 1
# HELP hlmg_tunnel_write_failures_total Request frames that could not be written to the tunnel; class=backpressure means the write timed out (connection-level backpressure, not evicted), class=broken means the write returned an error (connection treated as broken and evicted).
# TYPE hlmg_tunnel_write_failures_total counter
hlmg_tunnel_write_failures_total{class="backpressure"} 1
# HELP hlmg_bytes_out Bytes forwarded to clients.
# TYPE hlmg_bytes_out counter
hlmg_bytes_out 7
# HELP hlmg_request_duration_ms Total request duration in ms (sum).
# TYPE hlmg_request_duration_ms counter
hlmg_request_duration_ms 0
# HELP hlmg_request_count Total requests (sum).
# TYPE hlmg_request_count counter
hlmg_request_count 0
# HELP hlmg_requests_aborted_total Requests dropped before a status was written (client aborted or the connection was cut).
# TYPE hlmg_requests_aborted_total counter
hlmg_requests_aborted_total 1
# HELP hlmg_key_verify_hits_total Cached key verifications served without argon2.
# TYPE hlmg_key_verify_hits_total counter
hlmg_key_verify_hits_total 3
# HELP hlmg_key_verify_misses_total Key verifications that ran argon2 (a cache miss, or the cache is disabled via verified_cache_max: 0).
# TYPE hlmg_key_verify_misses_total counter
hlmg_key_verify_misses_total 4
# HELP hlmg_quic_connections Currently open agent QUIC connections.
# TYPE hlmg_quic_connections gauge
hlmg_quic_connections 1
# HELP hlmg_quic_accepting Whether the tunnel entry still accepts new edge connections (1/0).
# TYPE hlmg_quic_accepting gauge
hlmg_quic_accepting 1
# HELP hlmg_http_accept_errors_total Public entry accept() failures (EMFILE, ECONNABORTED, ...); the entry keeps listening and retries with backoff.
# TYPE hlmg_http_accept_errors_total counter
hlmg_http_accept_errors_total 1
# HELP hlmg_agent_connections_total Cumulative agent connections (reconnects).
# TYPE hlmg_agent_connections_total counter
hlmg_agent_connections_total 1
